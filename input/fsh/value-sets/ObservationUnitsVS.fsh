ValueSet: CZ_ObservationUnitsHeightVs
Id: cz-observation-units-height-vs
Title: "CZ Observation Units Height ValueSet"
Description: "Allowed UCUM units for body height observations in the Czech K-Order project."
* ^experimental = false

* http://unitsofmeasure.org#cm "cm"
* http://unitsofmeasure.org#m "m"

ValueSet: CZ_ObservationUnitsWeightVs
Id: cz-observation-units-weight-vs
Title: "CZ Observation Units Weight ValueSet"
Description: "Allowed UCUM units for body weight observations in the Czech K-Order project."
* ^experimental = false

* http://unitsofmeasure.org#kg "kg"
* http://unitsofmeasure.org#g "g"
